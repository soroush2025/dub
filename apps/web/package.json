{
  "name": "web",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "dev": "concurrently --kill-others \"pnpm prisma:generate && next dev --turbo --port 8888\" \"pnpm prisma:generate && pnpm prisma:studio --browser none\"",
    "build": "pnpm prisma:generate && next build",
    "lint": "next lint",
    "start": "next start",
    "script": "tsx ./scripts/run.ts",
    "test": "vitest -no-file-parallelism --bail=1",
    "generate-openapi": "tsx ./scripts/generate-openapi.ts",
    "prisma:generate": "dotenv-flow -e .env -- pnpm --filter=@dub/prisma generate",
    "prisma:push": "dotenv-flow -e .env -- pnpm --filter=@dub/prisma push",
    "prisma:studio": "dotenv-flow -e .env -- pnpm --filter=@dub/prisma studio",
    "prisma:format": "dotenv-flow -e .env -- pnpm --filter=@dub/prisma format"
  },
